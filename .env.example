# The full environment contract. Committed on purpose — names here, values never.
#
# Two files hold real values locally, and they have different owners:
#
#   .env.local  — OWNED BY VERCEL. Written by `vercel env pull`, which
#                 OVERWRITES it. Holds the Neon connection strings and the
#                 OIDC token. Never hand-edit; your edits will disappear.
#
#   .env        — owned by you. Everything below that Vercel does not manage.
#                 Never touched by the CLI.
#
# Next.js loads both; .env.local wins on conflicts. Both are gitignored.
# After filling a value locally, push it to Vercel so production has it too:
#
#   vercel env add OPENAI_API_KEY production preview development


# --- Database — Vercel-managed, do not set by hand --------------------------
# Provisioned by `vercel integration add neon --plan free_v3`.
DATABASE_URL=                          # pooled; app queries
DATABASE_URL_UNPOOLED=                 # direct; migrations only


# --- Generated secrets — no external account needed -------------------------
AUTH_SECRET=                           # signs Auth.js sessions
INTERNAL_API_SECRET=                   # shared header, Next.js -> FastAPI
CRON_SECRET=                           # guards the booking-hold expiry cron


# --- Phase 4 · availability & pricing ---------------------------------------
PYTHON_API_URL=http://127.0.0.1:8000


# --- Phase 5 · payments (Stripe TEST MODE ONLY) -----------------------------
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=


# --- Phase 6 · sign in ------------------------------------------------------
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=


# --- Phase 8 · search by feeling --------------------------------------------
OPENAI_API_KEY=                        # text-embedding-3-small


# --- Phase 9 · imagery, living scenes, sound --------------------------------
FAL_KEY=                               # image-to-video loops
ELEVENLABS_API_KEY=                    # ambient sound beds
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=stillnest-media

# Empty means "serve media from /public", which is the current behaviour.
# Setting this to the R2 public base IS the migration — nothing else changes.
NEXT_PUBLIC_MEDIA_BASE_URL=
