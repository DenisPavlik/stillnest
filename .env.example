# Copy to .env.local and fill in. Never commit .env.local.
# Every key here is project-scoped — do not reuse another project's.

# --- Database (Neon) ---------------------------------------------------------
# Free plan: up to 10 projects, no card required, pgvector + btree_gist available.
DATABASE_URL=
DATABASE_URL_UNPOOLED=          # direct connection — migrations only

# --- Auth.js v5 --------------------------------------------------------------
AUTH_SECRET=                    # openssl rand -base64 32
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Python service ----------------------------------------------------------
PYTHON_API_URL=http://127.0.0.1:8000
INTERNAL_API_SECRET=            # shared header between Next.js and FastAPI

# --- Embeddings (Phase 8) ----------------------------------------------------
OPENAI_API_KEY=                 # text-embedding-3-small — pennies for this catalog

# --- Stripe (TEST MODE ONLY — never live keys) -------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Media -------------------------------------------------------------------
# Empty = serve from /public. Set to the Cloudflare R2 / Worker base URL in Phase 9.
NEXT_PUBLIC_MEDIA_BASE_URL=
